/* Rôle : Définir le thème sombre commun des composants Qt de MARGIN. */

QWidget { background-color: #2b2b2b; color: #f0f0f0; font-size: 12px; }
QPushButton {
  background-color: #3c3f41; color: #dcdcdc;
  border: 1px solid #5c5c5c; border-radius: 8px;
  padding: 10px 14px; font-size: 13px;
}
QPushButton:hover { background-color: #505357; }
QComboBox, QLineEdit {
  background-color: #3c3f41; border: 1px solid #5c5c5c;
  border-radius: 6px; padding: 6px 10px; font-size: 12px;
}
QComboBox QAbstractItemView {
  background-color: #2b2b2b; selection-background-color: #505357;
}
QSlider::groove:horizontal {
  background: #5c5c5c; height: 10px; border-radius: 5px;
}
QSlider::handle:horizontal {
  background: #dcdcdc; width: 18px; margin: -4px 0; border-radius: 9px;
}
QTabBar::tab {
  background: #3c3f41; color: #dcdcdc;
  padding: 10px 18px; border-top-left-radius: 6px; border-top-right-radius: 6px;
  font-size: 13px;
}
QTabBar::tab:selected { background: #2b2b2b; }
QGroupBox { font-weight: bold; margin-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 3px; }
QCheckBox { spacing: 6px; font-size: 12px; }
QLabel { font-size: 12px; }

